{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NumWorks Apps Catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "applications"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "applications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/application"
      }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "version",
        "downloadUrl",
        "sha256",
        "requiresData"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requiresData": {
          "type": "boolean"
        },
        "iconUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "additionalProperties": true
    }
  }
}
